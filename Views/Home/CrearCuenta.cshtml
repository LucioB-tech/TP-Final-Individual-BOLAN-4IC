@{
    ViewData["Title"] = "Crear cuenta";
    var error = ViewBag.Error as string;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="text-center">Crear cuenta</h1>
        <p class="text-center">Registra tu usuario para acceder a BiblioLucio</p>
        <form asp-controller="Home" asp-action="CrearCuenta" method="post" id="formCrearCuenta" novalidate>
            <div class="mb-3">
                <label for="nombre" class="form-label">Nombre</label>
                <input type="text" name="nombre" id="nombre" class="form-control" maxlength="50" required />
                <small class="text-danger" id="errorNombre"></small>
            </div>
            <div class="mb-3">
                <label for="apellido" class="form-label">Apellido</label>
                <input type="text" name="apellido" id="apellido" class="form-control" maxlength="50" required />
                <small class="text-danger" id="errorApellido"></small>
            </div>
            <div class="mb-3">
                <label for="nombreUsuario" class="form-label">Usuario</label>
                <input type="text" name="nombreUsuario" id="nombreUsuario" class="form-control" maxlength="50" required />
                <small class="text-danger" id="errorNombreUsuario"></small>
            </div>
            <div class="mb-3">
                <label for="contrasena" class="form-label">Contraseña</label>
                <input type="password" name="contrasena" id="contrasena" class="form-control" minlength="6" maxlength="50" required />
                <small class="text-danger" id="errorContrasena"></small>
            </div>
        
            <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
        </form>
        @if (!string.IsNullOrEmpty(error))
        {
            <p class="text-danger mt-3">@error</p>
        }
        <p class="mt-3 text-center">¿Ya tenes cuenta? <a asp-action="Login">Inicia sesion</a></p>
</div>
<script src="~/js/validaciones-auth.js" asp-append-version="true"></script>
